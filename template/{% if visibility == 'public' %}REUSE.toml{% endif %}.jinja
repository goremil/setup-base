version = 1
SPDX-PackageName = "{{ project_name }}"
SPDX-PackageDownloadLocation = "https://github.com/{{ forge_owner }}/{{ project_name }}"

# Code, build definitions and configuration: {{ code_licence }}.
[[annotations]]
path = ["**"]
precedence = "aggregate"
SPDX-FileCopyrightText = "{{ project_name }} contributors"
SPDX-License-Identifier = "{{ code_licence }}"

# Documentation: CC-BY-SA-4.0.
[[annotations]]
path = ["**.md"]
precedence = "aggregate"
SPDX-FileCopyrightText = "{{ project_name }} contributors"
SPDX-License-Identifier = "CC-BY-SA-4.0"
