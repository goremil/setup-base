# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# shfmt reads these: case branches indented, the style the scripts already had.
switch_case_indent = true

# Markdown: trailing whitespace is a hard line break, keep it.
[*.md]
trim_trailing_whitespace = false
